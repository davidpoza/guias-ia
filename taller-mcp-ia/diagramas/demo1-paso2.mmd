flowchart LR
  subgraph EMP["Empleado"]
    A["Rellena el formulario"]
    FA(["Vacaciones aprobadas"])
    FR(["Solicitud rechazada"])
  end
  subgraph SIS["Sistema"]
    B{"¿Datos completos?"}
    C["Envía al responsable"]
    NA["Notifica la aprobación"]
    NR["Notifica el rechazo<br>con el motivo"]
  end
  subgraph RES["Responsable"]
    D{"¿Aprueba?"}
    M["Indica el motivo"]
  end
  A --> B
  B -->|"Incompleta: falta un dato"| A
  B -->|"Completa"| C
  C --> D
  D -->|"Aprueba"| NA
  D -->|"Rechaza"| M
  M --> NR
  NA --> FA
  NR --> FR
  classDef step fill:#EEF4FF,stroke:#9DB8F2,color:#1B1F24
  classDef decision fill:#FFF6E0,stroke:#E8C36A,color:#1B1F24
  classDef ok fill:#E7F6EC,stroke:#8BCB9F,color:#1B1F24
  classDef ko fill:#FDECEC,stroke:#EBA3A3,color:#1B1F24
  class A,C,M step
  class B,D decision
  class NA,FA ok
  class NR,FR ko
  linkStyle default stroke:#8A94A6
